# Copy to the Droplet as /opt/tokenstats/.env (next to docker-compose.yml)
#   cp deploy/env.example .env && nano .env

# Hostnames for Caddy / Let's Encrypt (comma-separated list is OK)
# Examples:
#   DOMAIN=tokenstats.ai
#   DOMAIN=tokenstats.ai, www.tokenstats.ai
#   DOMAIN=tokenta.pe
#   DOMAIN=tokenstats.ai, tokenta.pe
DOMAIN=tokenstats.ai
# ACME registration email (Caddy / Let's Encrypt)
ACME_EMAIL=admin@tokenstats.ai

# Image tag pulled from ghcr.io/johnzilla/tokenstats (CI publishes :latest and
# :sha-<short> for every green main). Pin a sha tag to hold or roll back.
# TOKENSTATS_TAG=latest

# App
TOKENSTATS_POLL_INTERVAL_SECS=60
TOKENSTATS_BTC_INTERVAL_SECS=60
TOKENSTATS_PERSIST_INTERVAL_SECS=30
RUST_LOG=info,tokenstats=info,tower_http=info

# Optional Plausible analytics (off when unset). Must be an https:// URL; the
# app's Content-Security-Policy then allows that origin and nothing else.
# TOKENSTATS_PLAUSIBLE_SCRIPT=https://plausible.io/js/pa-XXXXXXXX.js

# Host binding for the app's port. Docker publishes ports by writing its own
# iptables rules, which bypass UFW, so a bare "8080" is reachable from the
# internet even when UFW doesn't allow it. With the Caddy profile the app only
# needs to be reachable on localhost (Caddy uses the internal network).
# Use plain 8080 only for app-only / IP smoke tests without Caddy (§4b).
TOKENSTATS_PUBLISH_PORT=127.0.0.1:8080
